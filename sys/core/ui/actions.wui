<!-- ui/actions.wui -->
<style>
/* Self-contained overlay style */
#actionsOverlay {
  display: none; /* starts hidden */
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,77,0,0.9);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

#actionsOverlayContent {
  background: #003300;
  border: 2px solid #00ff00;
  padding: 30px;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  gap: 15px;
  min-width: 200px;
  align-items: center;
}

#actionsOverlayContent button {
  width: 150px;
  padding: 10px 20px;
  font-size: 1.2rem;
  background: #004d00;
  border: 2px solid #00ff00;
  color: #00ff00;
  border-radius: 5px;
  cursor: pointer;
}

#actionsOverlayContent button:hover {
  background: #00bb00;
  color: #004d00;
}
</style>

<div id="actionsOverlay">
  <div id="actionsOverlayContent">
    <button data-action="screenOff">Screen Off</button>
    <button data-action="reboot">Reboot</button>
    <button data-action="respring">Respring</button>
    <button data-action="launchApp" data-url="app.html?show=https://example.com/app1">Launch App 1</button>
    <button data-action="launchApp" data-url="app.html?show=https://example.com/app2">Launch App 2</button>
    <button data-action="cancel">Cancel</button>
  </div>
</div>

<script>
(function() {
  const overlay = document.getElementById('actionsOverlay');

  // Function to show the overlay
  window.showActions = function() {
    overlay.style.display = 'flex';
  };

  // Function to hide the overlay
  function hideOverlay() {
    overlay.style.display = 'none';
  }

  // Button click handling
  overlay.querySelectorAll('button').forEach(button => {
    button.addEventListener('click', () => {
      const action = button.dataset.action;
      switch(action) {
        case 'screenOff':
          alert('Screen Off triggered (placeholder)');
          hideOverlay();
          break;
        case 'reboot':
          alert('Reboot triggered (placeholder)');
          hideOverlay();
          break;
        case 'respring':
          alert('Respring triggered (placeholder)');
          hideOverlay();
          break;
        case 'launchApp':
          const url = button.dataset.url;
          if(url) window.location.href = url;
          hideOverlay();
          break;
        case 'cancel':
          hideOverlay();
          break;
        default:
          console.log('Unknown action:', action);
          hideOverlay();
      }
    });
  });

  // Clicking outside overlay content closes overlay
  overlay.addEventListener('click', e => {
    if(e.target === overlay) hideOverlay();
  });

})();
</script>
